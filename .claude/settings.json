{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "attribution": { "commit": "", "pr": "" },

  "disableClaudeAiConnectors": true,
  "enabledMcpjsonServers": ["github", "terraform", "azure"],
  "enabledPlugins": {
    "design@synced": false,
    "marketing@synced": false,
    "finance@synced": false,
    "productivity@synced": false,
    "cowork-plugin-management@synced": false,
    "pdf-viewer@synced": false,
    "desktop-commander@synced": false
  },

  "permissions": {
    "additionalDirectories": ["../Sentinel", "../Sentinel-deployment", "../Sentinel-infra"],
    "allow": [
      "Read",
      "Edit",
      "Write",

      "Bash(python3 *)",
      "Bash(python3.12 *)",
      "Bash(poetry *)",
      "Bash(pip *)",
      "Bash(ruff *)",
      "Bash(pyright *)",
      "Bash(pytest *)",
      "Bash(uvicorn *)",
      "Bash(../Sentinel/.venv/bin/*)",
      "Bash(../Sentinel-deployment/.venv/bin/*)",
      "Bash(../Sentinel-infra/.venv/bin/*)",

      "Bash(terraform *)",
      "Bash(tflint *)",
      "Bash(tfsec *)",
      "Bash(shellcheck *)",
      "Bash(actionlint *)",
      "Bash(yamllint *)",
      "Bash(gitleaks *)",
      "Bash(docker *)",
      "Bash(az * show *)",
      "Bash(az * list *)",
      "Bash(az account *)",
      "Bash(az version)",

      "Bash(git *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(gh repo view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh project view *)",
      "Bash(gh project item-list *)",
      "Bash(gh auth status)",

      "Bash(cat *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(diff *)",
      "Bash(jq *)",
      "Bash(tree *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",

      "Skill(progress)",
      "Skill(check)",
      "Skill(review)",
      "Skill(ground-rules)",

      "mcp__github",
      "mcp__terraform",
      "mcp__azure"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(gh pr merge *)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform import*)",
      "Bash(terraform state *)",
      "Bash(terraform workspace delete*)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(/archive/**)",
      "Read(./archive/**)",
      "Edit(/archive/**)",
      "Write(/archive/**)"
    ]
  },

  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR}\" && echo '[sentinel] where.py (live tracker):' && python3 scripts/where.py; exit 0",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit|Grep|Glob|mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
